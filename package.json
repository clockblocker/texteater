{
	"name": "textfresser-batteries",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"app/*",
		"battery/*"
	],
	"scripts": {
		"build": "bun tooling/manifest-policy.ts repository && bun tooling/run-workspaces.ts build",
		"check": "bun tooling/run-workspaces.ts check --if-present",
		"fix": "bun tooling/run-workspaces.ts fix --if-present",
		"lint": "bun tooling/run-workspaces.ts lint --if-present",
		"test": "bun test tooling && bun tooling/run-workspaces.ts test",
		"validate": "bun tooling/validate-repository.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.6",
		"@types/node": "^24.5.2",
		"bun-types": "1.3.14",
		"dependency-cruiser": "^18.1.0",
		"knip": "^6.29.0",
		"typescript": "^7.0.2"
	}
}
