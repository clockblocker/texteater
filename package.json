{
	"name": "textfresser-batteries",
	"private": true,
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "24.x"
	},
	"workspaces": [
		"app/*",
		"battery/*"
	],
	"scripts": {
		"benchmark:dum-shared": "bun tooling/dum-entrypoint-rss/shared.ts",
		"benchmark:dum-entrypoints": "bun tooling/dum-entrypoint-rss/benchmark.ts",
		"build": "bun tooling/manifest-policy.ts repository && turbo run build:package",
		"check": "turbo run check check:tooling --continue",
		"check:docs": "bun tooling/documentation-integrity.ts",
		"check:tooling": "bun node_modules/typescript/bin/tsc -p tooling/tsconfig.json --noEmit",
		"ci": "PATH=\"$PWD/node_modules/node/bin:$PATH\" bun tooling/ci.ts",
		"demo": "PATH=\"$PWD/node_modules/node/bin:$PATH\" turbo run dev:package --filter=@texteater/tf-demo",
		"fix": "turbo run fix --continue",
		"knip": "bun tooling/knip.ts",
		"lint": "turbo run lint lint:tooling --continue",
		"lint:tooling": "biome check --config-path tooling/biome/base.json tooling",
		"resolution_inspector": "bun app/tf-demo/tooling/resolution-inspector.ts",
		"test": "turbo run test test:tooling --continue",
		"test:tooling": "bun test ./tooling",
		"validate": "bun tooling/ci.ts validate knip dum-runtime",
		"validate:imports": "bun tooling/validate-repository-architecture.ts",
		"validate:manifests": "bun tooling/manifest-policy.ts repository",
		"verify:dum-runtime": "bun tooling/dum-runtime-verification/verify.ts"
	},
	"devDependencies": {
		"@babel/core": "7.29.7",
		"@babel/preset-react": "7.28.5",
		"@babel/preset-typescript": "7.29.7",
		"@biomejs/biome": "2.5.13",
		"@clockblocker/ts7-plugin-sort-import-suggestions": "^2.0.0",
		"@swc/core": "1.16.1",
		"@types/node": "^24.13.3",
		"bun-types": "1.4.2",
		"dependency-cruiser": "^18.1.0",
		"knip": "^6.29.0",
		"node": "24.19.0",
		"oxc-parser": "^0.140.0",
		"turbo": "2.10.12",
		"typescript": "^7.0.2",
		"effect": "4.0.0"
	}
}
