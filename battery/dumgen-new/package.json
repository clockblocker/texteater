{
	"name": "dumgen",
	"version": "0.1.0",
	"description": "Encounter-based linguistic production over Dumling and Dumrel.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js"
		},
		"./schemas": {
			"types": "./dist/schemas.d.ts",
			"import": "./dist/schemas.js"
		},
		"./development": {
			"types": "./dist/development.d.ts",
			"import": "./dist/development.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run generate:check && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/types.ts src/schemas.ts src/development.ts --bundle --outdir=dist --platform=node --format=esm --packages=external",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"generate": "bun codegen/generate.ts",
		"generate:check": "bun codegen/generate.ts --check",
		"test": "bun test",
		"lint": "bun run --silent biome check .",
		"fix": "bun run --silent biome check --write .",
		"validate": "bun ../../tooling/validate-package.ts",
		"evaluate": "bun cli/evaluate.ts"
	},
	"dependencies": {
		"common-utils": "workspace:^",
		"dumling": "workspace:^",
		"dumrel": "workspace:^",
		"effect": "3.22.1",
		"zod": "^4.4.0",
		"promptsmith": "workspace:^"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.13.3",
		"bun-types": "1.4.2",
		"codegen": "workspace:^",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"prinfer": "^2.3.0",
		"typescript": "^7.0.2"
	}
}
