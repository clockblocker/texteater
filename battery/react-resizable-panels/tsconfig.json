{
	"extends": "../../tooling/typescript/battery.json",
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"noUncheckedIndexedAccess": false,
		"types": [
			"node",
			"bun-types",
			"@testing-library/jest-dom",
			"@testing-library/jest-dom/vitest"
		],
		"paths": {
			"react-resizable-panels": ["./lib/index.ts"],
			"react-resizable-panels/workspace": ["./workspace/index.ts"]
		}
	},
	"include": [
		"e2e",
		"lib",
		"playwright.config.ts",
		"vitest.config.ts",
		"vitest.d.ts",
		"vitest.setup.ts",
		"workspace"
	]
}
