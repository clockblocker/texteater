{
	"name": "codec-builder-library",
	"version": "0.1.0",
	"description": "Composable Zod codec builders for reshaping and adapting data structures.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && rm -rf dist && bun ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"test": "bun test",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^24.5.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"bun-types": "1.3.14",
		"dependency-cruiser": "^18.1.0",
		"knip": "^6.29.0",
		"typescript": "^6.0.2"
	}
}
