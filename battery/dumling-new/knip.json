{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/index.ts",
		"src/types.ts",
		"codegen/generate.ts",
		"generate-readme/examples/**/*.ts",
		"tests/**/*.ts"
	],
	"project": [
		"codegen/**/*.ts",
		"generate-readme/**/*.ts",
		"src/**/*.ts",
		"tests/**/*.ts"
	],
	"ignoreDependencies": ["@biomejs/biome", "bun-types", "dependency-cruiser"]
}
