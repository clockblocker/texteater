{
	"name": "dumling",
	"version": "0.1.12",
	"description": "Zod-authored linguistic units with compiled validation and schema-free consumer types.",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"typescript",
		"zod",
		"schema",
		"linguistics",
		"nlp",
		"annotation",
		"lemma",
		"inflection",
		"segmentation",
		"language-learning",
		"english",
		"german",
		"hebrew"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js",
			"default": "./dist/types.js"
		},
		"./package.json": "./package.json",
		"./schema/*": {
			"types": "./dist/generated/schemas/*.d.ts",
			"import": "./dist/generated/schemas/*.js",
			"default": "./dist/generated/schemas/*.js"
		}
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run generate:validation:check && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/types.ts --bundle --outdir=dist --platform=node --format=esm --packages=external --minify-syntax --minify-whitespace && bun codegen/build-schemas.ts",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"check:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.type-tests.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"generate": "bun run generate:validation",
		"generate:validation": "bun codegen/generate.ts",
		"generate:validation:check": "bun codegen/generate.ts --check",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run build",
		"test": "bun test ./tests",
		"test:package": "bun test ./tests/package.test.ts",
		"validate:architecture": "bun ../../node_modules/dependency-cruiser/bin/dependency-cruise.mjs --config dependency-cruiser.cjs --ts-config tsconfig.json -- src",
		"validate": "bun ../../tooling/validate-package.ts",
		"validate:test": "bun run test"
	},
	"dependencies": {
		"common-utils": "workspace:^",
		"emoji-regex": "^10.6.0",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.13.3",
		"bun-types": "1.4.2",
		"codegen": "workspace:^",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"prinfer": "^2.3.0",
		"typescript": "^7.0.2"
	}
}
