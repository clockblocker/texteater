{
	"name": "common-utils",
	"version": "0.1.0",
	"description": "Shared lightweight runtime utilities for generated textfresser validators.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types && bun run build:contract",
		"build:contract": "bun run tests/published-build-contract.ts",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts --bundle --outfile=dist/index.js --platform=node --format=esm --packages=external --minify-syntax --minify-whitespace",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"check:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.type-tests.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run build",
		"test": "bun test",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.13.3",
		"bun-types": "1.3.14",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"typescript": "^7.0.2",
		"zod": "^4.4.0"
	}
}
