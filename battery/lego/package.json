{
	"name": "lego",
	"private": true,
	"version": "0.0.1",
	"description": "Shared Tailwind design tokens, theme machinery, and React atoms and molecules for Texteater applications.",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "24.x"
	},
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./src/styles.css",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src/styles.css",
		"README.md"
	],
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run check && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && bun run esbuild src/index.ts --bundle --platform=browser --format=esm --packages=external --banner:js='\"use client\";' --outfile=dist/index.js",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run build",
		"test": "bun ../../tooling/run-package-tests.ts",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"peerDependencies": {
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@fontsource-variable/geist": "^5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"react-resizable-panels": "workspace:^",
		"shadcn": "^4.18.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"bun-types": "1.4.2",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"typescript": "^7.0.2"
	}
}
