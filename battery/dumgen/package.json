{
	"name": "dumgen",
	"version": "0.1.0",
	"description": "Generation helpers built on top of dumling.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./projection": {
			"types": "./dist/projection.d.ts",
			"import": "./dist/projection.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js"
		},
		"./knowledge": {
			"types": "./dist/knowledge.d.ts",
			"import": "./dist/knowledge.js"
		},
		"./knowledge-runtime": {
			"types": "./dist/knowledge-runtime.d.ts",
			"import": "./dist/knowledge-runtime.js"
		},
		"./openai-fetch": {
			"types": "./dist/openai-fetch.d.ts",
			"import": "./dist/openai-fetch.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./vocabulary": {
			"types": "./dist/vocabulary.d.ts",
			"import": "./dist/vocabulary.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/knowledge.ts src/knowledge-runtime.ts src/openai-fetch.ts src/projection.ts src/runtime.ts src/schema.ts src/vocabulary.ts --bundle --outdir=dist --platform=node --format=esm --packages=external",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"generate:system-prompts": "bun run src/promptsmith/assembly/generate-system-prompts.ts",
		"check:system-prompts": "bun run src/promptsmith/assembly/generate-system-prompts.ts --check",
		"generate:readme": "bun run generate-readme/generate-readme.ts",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run generate:readme && bun run build",
		"prototype:knowledge-analysis-combined": "bun --env-file ../../.env.local docs/prototypes/knowledge-analysis-combined/run.ts",
		"prototype:german-relation-topology-lab": "bun --env-file ../../.env.local docs/prototypes/german-relation-topology-lab/run.ts",
		"prototype:german-relation-prompt-iteration-lab": "bun --env-file ../../.env.local docs/prototypes/german-relation-prompt-iteration-lab/run.ts",
		"review:german-relation-human-gate": "bun --env-file ../../.env.local docs/prototypes/german-relation-human-gate/review.ts",
		"prototype:target-classification-high-level": "bun --env-file ../../.env.local docs/prototypes/target-classification-high-level-contracts/run.ts",
		"prototype:unit-shadow-classification": "bun --env-file ../../.env.local docs/prototypes/unit-shadow-classification/run.ts",
		"prototype:target-classification-partizip-ii": "bun --env-file ../../.env.local docs/prototypes/target-classification-partizip-ii/run.ts",
		"test": "bun test",
		"test:external": "bun test tests/external",
		"test:internal": "bun test tests/internal",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"codec-builder-library": "workspace:^",
		"dumdict": "workspace:^",
		"dumling": "workspace:^",
		"dumrel": "workspace:^",
		"emoji-regex": "^10.6.0",
		"openai": "^7.0.0",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.13.3",
		"bun-types": "1.3.14",
		"codegen": "workspace:^",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"typescript": "^7.0.2"
	}
}
