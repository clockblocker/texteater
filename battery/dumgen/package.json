{
	"name": "dumgen",
	"version": "0.1.0",
	"description": "Generation helpers built on top of dumling.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && bun build src/index.ts --outfile dist/index.js --format esm --target node --packages external",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"check:experiment:issue-22": "bun run src/promptsmith/laboratory/experiments/issue-22-compact-noun-dtos/generate-system-prompts.ts --check",
		"experiment:issue-22": "bun run docs/prototypes/issue-22-compact-noun-dtos/run.ts measure",
		"experiment:issue-22:live": "bun --env-file ../../.env.local docs/prototypes/issue-22-compact-noun-dtos/run.ts live",
		"fix": "bun run --silent biome check --write .",
		"generate:experiment:issue-22": "bun run src/promptsmith/laboratory/experiments/issue-22-compact-noun-dtos/generate-system-prompts.ts",
		"generate:system-prompts": "bun run src/promptsmith/assembly/generate-system-prompts.ts",
		"check:system-prompts": "bun run src/promptsmith/assembly/generate-system-prompts.ts --check",
		"generate:readme": "bun run generate-readme/generate-readme.ts",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run generate:readme && bun run build",
		"prototype:grammatical-resolution-aphorism": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-aphorism/run.ts",
		"prototype:grammatical-resolution-batch": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-batch/run.ts",
		"prototype:grammatical-resolution-adjective": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-adjective/run.ts",
		"prototype:grammatical-resolution-adposition": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-adposition/run.ts",
		"prototype:grammatical-resolution-adverb": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-adverb/run.ts",
		"prototype:grammatical-resolution-auxiliary": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-auxiliary/run.ts",
		"prototype:grammatical-resolution-coordinating-conjunction": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-coordinating-conjunction/run.ts",
		"prototype:grammatical-resolution-collocation": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-collocation/run.ts",
		"prototype:grammatical-resolution-determiner": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-determiner/run.ts",
		"prototype:grammatical-resolution-discourse-formula": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-discourse-formula/run.ts",
		"prototype:grammatical-resolution-fusion": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-fusion/run.ts",
		"prototype:grammatical-resolution-idiom": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-idiom/run.ts",
		"prototype:grammatical-resolution-interjection": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-interjection/run.ts",
		"prototype:grammatical-resolution-noun": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-noun/run.ts",
		"prototype:grammatical-resolution-numeral": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-numeral/run.ts",
		"prototype:grammatical-resolution-other": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-other/run.ts",
		"prototype:grammatical-resolution-particle": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-particle/run.ts",
		"prototype:grammatical-resolution-paired-frame": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-paired-frame/run.ts",
		"prototype:grammatical-resolution-proverb": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-proverb/run.ts",
		"prototype:grammatical-resolution-pronoun": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-pronoun/run.ts",
		"prototype:grammatical-resolution-proper-noun": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-proper-noun/run.ts",
		"prototype:grammatical-resolution-subordinating-conjunction": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-subordinating-conjunction/run.ts",
		"prototype:grammatical-resolution-symbol": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-symbol/run.ts",
		"prototype:grammatical-resolution-verb": "bun --env-file ../../.env.local docs/prototypes/grammatical-resolution-verb/run.ts",
		"prototype:reading-resolution-gauntlet": "bun --env-file ../../.env.local docs/prototypes/reading-resolution-gauntlet/run.ts",
		"prototype:issue-6": "bun run prototypes/issue-6-selection-surface/run.ts",
		"prototype:issue-6:summarize": "bun run prototypes/issue-6-selection-surface/summarize.ts",
		"test": "bun test",
		"test:external": "bun test tests/external",
		"test:internal": "bun test tests/internal",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"codec-builder-library": "workspace:^",
		"dumdict": "workspace:^",
		"dumling": "workspace:^",
		"emoji-regex": "^10.6.0",
		"openai": "^7.0.0",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^24.5.2",
		"bun-types": "1.3.14",
		"dependency-cruiser": "^18.1.0",
		"codegen": "workspace:^",
		"knip": "^6.29.0",
		"typescript": "^7.0.2"
	}
}
