{
	"name": "dumgen",
	"version": "0.1.0",
	"description": "German segment.inUnits: groups a Sentence's Segments into its biggest units and routes each one.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./development": {
			"types": "./dist/development.d.ts",
			"import": "./dist/development.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "turbo run build:package",
		"build:package": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/development.ts --bundle --splitting --outdir=dist --platform=node --format=esm --packages=external",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"check:segment-in-units": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.segment-in-units.json --noEmit",
		"test": "bun test",
		"lint": "bun run --silent biome check .",
		"fix": "bun run --silent biome check --write .",
		"validate": "bun ../../tooling/validate-package.ts",
		"evaluate": "bun --env-file=../../.env.local cli/evaluate.ts",
		"spec-coverage": "bun cli/spec-coverage.ts",
		"segment-in-units-lab": "bun --env-file=../../.env.local cli/segment-in-units-lab.ts",
		"segment-in-units-attribution": "bun cli/segment-in-units-attribution.ts"
	},
	"dependencies": {
		"dumling": "workspace:^",
		"dumspec": "workspace:^",
		"promptsmith": "workspace:^",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.13.3",
		"bun-types": "1.4.2",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"prinfer": "^2.3.0",
		"typescript": "^7.0.2"
	}
}
