			],
			"expectedLanguages": ["de", "en", "he"],
			"stitching": [false, false, false]
		},
		{
			"id": "rewrite-intake-en-stitch",
			"sourceSentences": ["The win dow is open."],
			"expectedTexts": ["The window is open."],
			"expectedLanguages": ["en"],
			"stitching": [true]
		},
		{
			"id": "rewrite-intake-he-stitch",
			"sourceSentences": ["הח לון פתוח."],
			"expectedTexts": ["החלון פתוח."],
			"expectedLanguages": ["he"],
			"stitching": [true]
		},
		{
			"id": "rewrite-intake-de-stitch",
			"sourceSentences": ["Das Fen ster ist offen."],
			"expectedTexts": ["Das Fenster ist offen."],
			"expectedLanguages": ["de"],
			"stitching": [true]
		},
		{
