|\\\\u27A1\\\\uFE0F?))?)|\\\\uD83E(?:[\\\\uDD0C\\\\uDD0F\\\\uDD18-\\\\uDD1F\\\\uDD30-\\\\uDD34\\\\uDD36\\\\uDD77\\\\uDDB5\\\\uDDB6\\\\uDDBB\\\\uDDD2\\\\uDDD3\\\\uDDD5\\\\uDEC3-\\\\uDEC5\\\\uDEF0\\\\uDEF2-\\\\uDEF8](?:\\\\uD83C[\\\\uDFFB-\\\\uDFFF])?|[\\\\uDD26\\\\uDD35\\\\uDD37-\\\\uDD39\\\\uDD3C-\\\\uDD3E\\\\uDDB8\\\\uDDB9\\\\uDDCD\\\\uDDCF\\\\uDDD4\\\\uDDD6-\\\\uDDDD](?:\\\\uD83C[\\\\uDFFB-\\\\uDFFF])?(?:\\\\u200D[\\\\u2640\\\\u2642]\\\\uFE0F?)?|[\\\\uDDDE\\\\uDDDF](?:\\\\u200D[\\\\u2640\\\\u2642]\\\\uFE0F?)?|[\\\\uDD0D\\\\uDD0E\\\\uDD10-\\\\uDD17\\\\uDD20-\\\\uDD25\\\\uDD27-\\\\uDD2F\\\\uDD3A\\\\uDD3F-\\\\uDD45\\\\uDD47-\\\\uDD76\\\\uDD78-\\\\uDDB4\\\\uDDB7\\\\uDDBA\\\\uDDBC-\\\\uDDCC\\\\uDDD0\\\\uDDE0-\\\\uDDFF\\\\uDE70-\\\\uDE7C\\\\uDE80-\\\\uDE8A\\\\uDE8E-\\\\uDEC2\\\\uDEC6\\\\uDEC8\\\\uDECD-\\\\uDEDC\\\\uDEDF-\\\\uDEEA\\\\uDEEF]|\\\\uDDCE(?:\\\\uD83C[\\\\uDFFB-\\\\uDFFF])?(?:\\\\u200D(?:[\\\\u2640\\\\u2642]\\\\uFE0F?(?:\\\\u200D\\\\u27A1\\\\uFE0F?)?|\\\\u27A1\\\\uFE0F?))?|\\\\uDDD1(?:\\\\u200D(?:[\\\\u2695\\\\u2696\\\\u2708]\\\\uFE0F?|\\\\uD83C[\\\\uDF3E\\\\uDF73\\\\uDF7C\\\\uDF84\\\\uDF93\\\\uDFA4\\\\uDFA8\\\\uDFEB\\\\uDFED]|\\\\uD83D[\\\\uDCBB\\\\uDCBC\\\\uDD27\\\\uDD2C\\\\uDE80\\\\uDE92]|\\\\uD83E(?:[\\\\uDDAF\\\\uDDBC\\\\uDDBD](?:\\\\u200D\\\\u27A1\\\\uFE0F?)?|[\\\\uDDB0-\\\\uDDB3\\\\uDE70]|\\\\uDD1D\\\\u200D\\\\uD83E\\\\uDDD1|\\\\uDDD1\\\\u200D\\\\uD83E\\\\uDDD2(?:\\\\u200D\\\\uD83E\\\\uDDD2)?|\\\\uDDD2(?:\\\\u200D\\\\uD83E\\\\uDDD2)?))|\\\\uD83C(?:\\\\uDFFB(?:\\\\u200D(?:[\\\\u2695\\\\u2696\\\\u2708]\\\\uFE0F?|\\\\u2764\\\\uFE0F?\\\\u200D(?:\\\\uD83D\\\\uDC8B\\\\u200D)?\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFC-\\\\uDFFF]|\\\\uD83C[\\\\uDF3E\\\\uDF73\\\\uDF7C\\\\uDF84\\\\uDF93\\\\uDFA4\\\\uDFA8\\\\uDFEB\\\\uDFED]|\\\\uD83D(?:[\\\\uDCBB\\\\uDCBC\\\\uDD27\\\\uDD2C\\\\uDE80\\\\uDE92]|\\\\uDC30\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFC-\\\\uDFFF])|\\\\uD83E(?:[\\\\uDDAF\\\\uDDBC\\\\uDDBD](?:\\\\u200D\\\\u27A1\\\\uFE0F?)?|[\\\\uDDB0-\\\\uDDB3\\\\uDE70]|\\\\uDD1D\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFF]|\\\\uDEEF\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFC-\\\\uDFFF])))?|\\\\uDFFC(?:\\\\u200D(?:[\\\\u2695\\\\u2696\\\\u2708]\\\\uFE0F?|\\\\u2764\\\\uFE0F?\\\\u200D(?:\\\\uD83D\\\\uDC8B\\\\u200D)?\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB\\\\uDFFD-\\\\uDFFF]|\\\\uD83C[\\\\uDF3E\\\\uDF73\\\\uDF7C\\\\uDF84\\\\uDF93\\\\uDFA4\\\\uDFA8\\\\uDFEB\\\\uDFED]|\\\\uD83D(?:[\\\\uDCBB\\\\uDCBC\\\\uDD27\\\\uDD2C\\\\uDE80\\\\uDE92]|\\\\uDC30\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB\\\\uDFFD-\\\\uDFFF])|\\\\uD83E(?:[\\\\uDDAF\\\\uDDBC\\\\uDDBD](?:\\\\u200D\\\\u27A1\\\\uFE0F?)?|[\\\\uDDB0-\\\\uDDB3\\\\uDE70]|\\\\uDD1D\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFF]|\\\\uDEEF\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB\\\\uDFFD-\\\\uDFFF])))?|\\\\uDFFD(?:\\\\u200D(?:[\\\\u2695\\\\u2696\\\\u2708]\\\\uFE0F?|\\\\u2764\\\\uFE0F?\\\\u200D(?:\\\\uD83D\\\\uDC8B\\\\u200D)?\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB\\\\uDFFC\\\\uDFFE\\\\uDFFF]|\\\\uD83C[\\\\uDF3E\\\\uDF73\\\\uDF7C\\\\uDF84\\\\uDF93\\\\uDFA4\\\\uDFA8\\\\uDFEB\\\\uDFED]|\\\\uD83D(?:[\\\\uDCBB\\\\uDCBC\\\\uDD27\\\\uDD2C\\\\uDE80\\\\uDE92]|\\\\uDC30\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB\\\\uDFFC\\\\uDFFE\\\\uDFFF])|\\\\uD83E(?:[\\\\uDDAF\\\\uDDBC\\\\uDDBD](?:\\\\u200D\\\\u27A1\\\\uFE0F?)?|[\\\\uDDB0-\\\\uDDB3\\\\uDE70]|\\\\uDD1D\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFF]|\\\\uDEEF\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB\\\\uDFFC\\\\uDFFE\\\\uDFFF])))?|\\\\uDFFE(?:\\\\u200D(?:[\\\\u2695\\\\u2696\\\\u2708]\\\\uFE0F?|\\\\u2764\\\\uFE0F?\\\\u200D(?:\\\\uD83D\\\\uDC8B\\\\u200D)?\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFD\\\\uDFFF]|\\\\uD83C[\\\\uDF3E\\\\uDF73\\\\uDF7C\\\\uDF84\\\\uDF93\\\\uDFA4\\\\uDFA8\\\\uDFEB\\\\uDFED]|\\\\uD83D(?:[\\\\uDCBB\\\\uDCBC\\\\uDD27\\\\uDD2C\\\\uDE80\\\\uDE92]|\\\\uDC30\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFD\\\\uDFFF])|\\\\uD83E(?:[\\\\uDDAF\\\\uDDBC\\\\uDDBD](?:\\\\u200D\\\\u27A1\\\\uFE0F?)?|[\\\\uDDB0-\\\\uDDB3\\\\uDE70]|\\\\uDD1D\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFF]|\\\\uDEEF\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFD\\\\uDFFF])))?|\\\\uDFFF(?:\\\\u200D(?:[\\\\u2695\\\\u2696\\\\u2708]\\\\uFE0F?|\\\\u2764\\\\uFE0F?\\\\u200D(?:\\\\uD83D\\\\uDC8B\\\\u200D)?\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFE]|\\\\uD83C[\\\\uDF3E\\\\uDF73\\\\uDF7C\\\\uDF84\\\\uDF93\\\\uDFA4\\\\uDFA8\\\\uDFEB\\\\uDFED]|\\\\uD83D(?:[\\\\uDCBB\\\\uDCBC\\\\uDD27\\\\uDD2C\\\\uDE80\\\\uDE92]|\\\\uDC30\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFE])|\\\\uD83E(?:[\\\\uDDAF\\\\uDDBC\\\\uDDBD](?:\\\\u200D\\\\u27A1\\\\uFE0F?)?|[\\\\uDDB0-\\\\uDDB3\\\\uDE70]|\\\\uDD1D\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFF]|\\\\uDEEF\\\\u200D\\\\uD83E\\\\uDDD1\\\\uD83C[\\\\uDFFB-\\\\uDFFE])))?))?|\\\\uDEF1(?:\\\\uD83C(?:\\\\uDFFB(?:\\\\u200D\\\\uD83E\\\\uDEF2\\\\uD83C[\\\\uDFFC-\\\\uDFFF])?|\\\\uDFFC(?:\\\\u200D\\\\uD83E\\\\uDEF2\\\\uD83C[\\\\uDFFB\\\\uDFFD-\\\\uDFFF])?|\\\\uDFFD(?:\\\\u200D\\\\uD83E\\\\uDEF2\\\\uD83C[\\\\uDFFB\\\\uDFFC\\\\uDFFE\\\\uDFFF])?|\\\\uDFFE(?:\\\\u200D\\\\uD83E\\\\uDEF2\\\\uD83C[\\\\uDFFB-\\\\uDFFD\\\\uDFFF])?|\\\\uDFFF(?:\\\\u200D\\\\uD83E\\\\uDEF2\\\\uD83C[\\\\uDFFB-\\\\uDFFE])?))?)){1,4}$\"}},\"required\":[\"decision\",\"emojiDescription\"],\"additionalProperties\":false}"},"path":"laboratory.readingResolution.de","systemPrompt":"We are helping a language learner distinguish meanings that are useful to distinguish.\n\nThe supplied *lemma* is already resolved and fixed. Do not revise it.\nConsider only the use marked by <TARGET>...</TARGET> in *markedContext*.\n\nChoose whether this use belongs to one of the learner's existing Readings for\nthis lemma:\n\n- Choose *Reuse* when an *existingEmojiDescription* is close enough to represent\n  the same learner-facing concept. Copy that description exactly.\n- Choose *New* when none is close enough, or when there are no existing\n  descriptions. Create a description that is not already in the supplied list.\n\nAn emojiDescription contains only one to four Unicode RGI emoji graphemes.\nNever include the lemma, a gloss, or explanatory text.\n\nDescribe only meaning that stays stable across attestations. Omit scenery,\nparticipants, tense, and other incidental details from the marked context.\nPrefer one conventional emoji by default. Use multiple emoji only when they\npreserve stable, useful lexical structure that one emoji cannot.\n\nWe follow a \"do not split semantic pennies\" policy:\n\n1. Different homonyms need different emoji descriptions.\n2. Related or polysemous uses should reuse one description unless doing so would\n   materially mislead a beginner.\n3. Prefer one broad, recognizable learner-facing concept over narrow\n   dictionary-style distinctions.\n\nThe decision and description must agree: *Reuse* requires an exact member of\n*existingEmojiDescriptions*; *New* requires a description that is not an exact\nmember.\n\nExamples to follow:\n\nExample 1\nInput:\n{\"existingEmojiDescriptions\":[\"🔑\"],\"lemma\":\"Schlüssel\",\"markedContext\":\"Geduld ist der <TARGET>Schlüssel</TARGET> zum Erfolg.\"}\nIdeal output:\n{\"decision\":\"Reuse\",\"emojiDescription\":\"🔑\"}\nExplanation (guidance only; not part of the output):\nConventional access-to-a-solution metaphor. The key concept still fits. Reuse.\n\nExample 2\nInput:\n{\"existingEmojiDescriptions\":[\"🐭\"],\"lemma\":\"Maus\",\"markedContext\":\"Bewege den Zeiger mit der <TARGET>Maus</TARGET>.\"}\nIdeal output:\n{\"decision\":\"New\",\"emojiDescription\":\"🖱️\"}\nExplanation (guidance only; not part of the output):\nComputer device, not the animal. New.\n\nExample 3\nInput:\n{\"existingEmojiDescriptions\":[\"🛏️⬆️\"],\"lemma\":\"aufstehen\",\"markedContext\":\"Die Bürger <TARGET>stehen</TARGET> gegen die Unterdrückung <TARGET>auf</TARGET>.\"}\nIdeal output:\n{\"decision\":\"New\",\"emojiDescription\":\"✊⬆️\"}\nExplanation (guidance only; not part of the output):\nRevolt, not leave bed. New.\n\nExample 4\nInput:\n{\"existingEmojiDescriptions\":[\"🤝\",\"🛠️\",\"🔗\"],\"lemma\":\"mit\",\"markedContext\":\"Wir rechnen <TARGET>mit</TARGET> Regen.\"}\nIdeal output:\n{\"decision\":\"Reuse\",\"emojiDescription\":\"🔗\"}\nExplanation (guidance only; not part of the output):\nrechnen mit fixed. mit only links.\n\nExample 5\nInput:\n{\"existingEmojiDescriptions\":[],\"lemma\":\"mit den Wölfen heulen\",\"markedContext\":\"Obwohl er anderer Meinung war, <TARGET>heulte</TARGET> er <TARGET>mit</TARGET> <TARGET>den</TARGET> <TARGET>Wölfen</TARGET>.\"}\nIdeal output:\n{\"decision\":\"New\",\"emojiDescription\":\"🐺🗣️🤝\"}\nExplanation (guidance only; not part of the output):\nThe complete marked idiom means conforming to the group despite disagreement; the compact sequence preserves its stable social structure. New.","validationRoots":{"input":"laboratory.readingResolution.de#input","modelInput":"laboratory.readingResolution.de#model-input","output":"laboratory.readingResolution.de#output"}}{"dispatch":{"outputPostcondition":"laboratory.unitShadowClassification:output-postcondition"},"generationParams":{"model":"gpt-5.6-luna","maxOutputTokens":128},"jsonSchemaPayloads":{"input":"{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"enum\":[\"de\",\"en\",\"he\"]},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"intendedUse\":{\"type\":\"string\",\"minLength\":1}},\"required\":[\"language\",\"canonicalForm\",\"intendedUse\"],\"additionalProperties\":false}","modelInput":"{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"enum\":[\"de\",\"en\",\"he\"]},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"intendedUse\":{\"type\":\"string\",\"minLength\":1}},\"required\":[\"language\",\"canonicalForm\",\"intendedUse\"],\"additionalProperties\":false}","output":"{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"type\":\"object\",\"properties\":{\"decision\":{\"type\":\"string\",\"enum\":[\"Resolved\",\"Unresolved\"]},\"target\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"family\":{\"type\":\"string\",\"enum\":[\"Lexeme\",\"Morpheme\",\"Phraseme\",\"Construction\"]},\"kind\":{\"type\":\"string\",\"enum\":[\"ADJ\",\"ADP\",\"ADV\",\"AUX\",\"CCONJ\",\"DET\",\"INTJ\",\"NOUN\",\"NUM\",\"PART\",\"PRON\",\"PROPN\",\"PUNCT\",\"SCONJ\",\"SYM\",\"VERB\",\"X\",\"Circumfix\",\"Clitic\",\"Duplifix\",\"Infix\",\"Interfix\",\"Prefix\",\"Root\",\"Suffix\",\"Suffixoid\",\"ToneMarking\",\"Transfix\",\"Aphorism\",\"Collocation\",\"DiscourseFormula\",\"Idiom\",\"Proverb\",\"Fusion\"]}},\"required\":[\"family\",\"kind\"],\"additionalProperties\":false},{\"type\":\"null\"}]}},\"required\":[\"decision\",\"target\"],\"additionalProperties\":false}"},"path":"laboratory.unitShadowClassification","systemPrompt":"<task>\nClassify the shallow grammar of one proposed Unit Shadow. The proposal already\nsupplies language, canonicalForm, and a concise intendedUse preserved by its\ncontaining relation or structure. Return only whether one exact Dumling Family\nand Kind is defensible.\n\nThis is deliberately not Lemma Resolution or Reading Resolution. Never create\nor infer Core Features, an opaque identity, a Reading, an emoji description,\nKnowledge, relations, definitions, translations, components, or a revised\ncanonical form.\n</task>\n\n<evidence_policy>\nUse canonicalForm and intendedUse together. canonicalForm alone cannot resolve\nhomographs. intendedUse may establish grammatical behavior, conventionalized\nmultiword status, morphological boundary role, or constructional shape. It is\nnot permission to guess a category merely because one would be plausible.\n\nReturn Resolved only when both Family and Kind are defensible. Return\nUnresolved when evidence is missing, conflicting, invalid, or supports several\nKinds; when a multiword string is only a freshly composed free phrase; when a\nfragment is proposed as a whole Lexeme, Phraseme, or Construction; or when the proposal\nhas plausible semantics but no defensible grammatical unit. Never pick a broad\nor residual Kind to hide uncertainty. X is Resolved only when intendedUse\nexplicitly establishes an intentionally unanalyzed lexical item.\n</evidence_policy>\n\n<families>\n- Lexeme: one lexical identity. Its fixed realization may contain one member or\n  several ordered, possibly discontinuous members, as with governed verbs and\n  correlatives. Kind is the whole unit's Universal-Dependencies-style part of\n  speech, never a mixture of member-local analyses: ADJ, ADP, ADV, AUX, CCONJ, DET, INTJ, NOUN, NUM, PART, PRON, PROPN, PUNCT, SCONJ, SYM, VERB, X.\n- Phraseme: one conventionalized multiword unit. Aphorism is a concise authored\n  maxim; Proverb is a traditional complete saying; DiscourseFormula performs a\n  conventional communicative act; Idiom has a conventional non-compositional\n  meaning; Collocation has restricted lexical choices while its overall\n  meaning remains compositional. Collocation is currently a German route only.\n  A free phrase and a merely transparent compound word are not Phrasemes.\n- Morpheme: a bound or internal minimal grammatical element. Choose one of\n  Circumfix, Clitic, Duplifix, Infix, Interfix, Prefix, Root, Suffix, Suffixoid, ToneMarking, Transfix only when intendedUse establishes that exact\n  boundary role. Orthographic hyphens and ellipses may display boundaries but\n  do not prove them by themselves. A Duplifix is an echo-reduplicative element\n  whose form or placement depends on a copied base, such as dismissive shm- in\n  fancy-shmancy; it is not an ordinary Prefix merely because its displayed\n  portion precedes the echo base. A Suffixoid is a productive bound final\n  element that remains more word-like than an ordinary suffix, such as\n  scandal-forming -gate; explicit evidence of that intermediate status is\n  sufficient and must not be downgraded to Unresolved.\n- Construction: a productive grammatical pattern rather than one fixed lexical\n  identity. Fusion is a grammatical combination whose form collapses\n  components. Fixed correlatives such as je … desto and the more … the more are\n  multi-member Lexemes, not Constructions.\n</families>\n\n<language_and_homographs>\nClassify the supplied language; never translate canonicalForm. German (de),\nEnglish (en), and Hebrew (he) are supported. Unpointed Hebrew and ordinary\nGerman or English spellings may be homographic. Resolve them only when\nintendedUse selects one grammatical analysis. Semantic difference alone does\nnot create a new Kind. Under the supported Hebrew annotation policy,\nexistential יש meaning \"there is/are\" is VERB, while modal יש meaning \"it is\npossible/one can\" is ADV; do not reinterpret the modal use as AUX.\n</language_and_homographs>\n\n<output_contract>\nReturn exactly {decision,target}. For Resolved, target is exactly {family,kind}.\nFor Unresolved, target is null. Never return language, canonicalForm,\nintendedUse, coreFeatures, Lemma or Reading identity, confidence, alternatives,\nor explanation.\n</output_contract>\n\n<final_check>\nBefore returning Resolved, ask: does the evidence prove this exact Family and\nKind, and is the proposed text a complete unit of that Family? If either answer\nis no, return Unresolved.\n</final_check>\n\nExamples to follow:\n\nExample 1\nInput:\n{\"canonicalForm\":\"Fahrzeug\",\"intendedUse\":\"The general thing that a car is a type of.\",\"language\":\"de\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Lexeme\",\"kind\":\"NOUN\"}}\nExplanation (guidance only; not part of the output):\nFahrzeug names a word-like nominal target. Do not infer any Core Features.\n\nExample 2\nInput:\n{\"canonicalForm\":\"permit\",\"intendedUse\":\"To allow an action to happen.\",\"language\":\"en\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Lexeme\",\"kind\":\"VERB\"}}\nExplanation (guidance only; not part of the output):\nThe intended predicative use disambiguates the homograph as VERB rather than its nominal use.\n\nExample 3\nInput:\n{\"canonicalForm\":\"ליד\",\"intendedUse\":\"Marks that one place is next to another place.\",\"language\":\"he\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Lexeme\",\"kind\":\"ADP\"}}\n\nExample 4\nInput:\n{\"canonicalForm\":\"ins Gras beißen\",\"intendedUse\":\"An established figurative expression meaning to die.\",\"language\":\"de\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Phraseme\",\"kind\":\"Idiom\"}}\n\nExample 5\nInput:\n{\"canonicalForm\":\"eine Entscheidung treffen\",\"intendedUse\":\"The conventional support-verb expression synonymous with entscheiden; its overall meaning remains compositional.\",\"language\":\"de\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Phraseme\",\"kind\":\"Collocation\"}}\n\nExample 6\nInput:\n{\"canonicalForm\":\"thank you\",\"intendedUse\":\"The conventional utterance used to express gratitude.\",\"language\":\"en\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Phraseme\",\"kind\":\"DiscourseFormula\"}}\n\nExample 7\nInput:\n{\"canonicalForm\":\"un-\",\"intendedUse\":\"The bound negative element at the left edge of words such as unklar.\",\"language\":\"de\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Morpheme\",\"kind\":\"Prefix\"}}\n\nExample 8\nInput:\n{\"canonicalForm\":\"כ־ת־ב\",\"intendedUse\":\"The discontinuous consonantal lexical base shared by כתב, מכתב, and כתיבה.\",\"language\":\"he\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Morpheme\",\"kind\":\"Root\"}}\n\nExample 9\nInput:\n{\"canonicalForm\":\"the more … the more …\",\"intendedUse\":\"The fixed correlating anchors of the comparative-correlative lexical identity, with open comparative slots.\",\"language\":\"en\"}\nIdeal output:\n{\"decision\":\"Resolved\",\"target\":{\"family\":\"Lexeme\",\"kind\":\"CCONJ\"}}\n\nExample 10\nInput:\n{\"canonicalForm\":\"seal\",\"intendedUse\":\"A related target called seal.\",\"language\":\"en\"}\nIdeal output:\n{\"decision\":\"Unresolved\",\"target\":null}\nExplanation (guidance only; not part of the output):\nThe evidence does not choose the nominal or verbal homograph. Plausibility is not exact classification.\n\nExample 11\nInput:\n{\"canonicalForm\":\"walk quickly\",\"intendedUse\":\"A freshly composed paraphrase of sprint, with no claim that the wording is conventionalized.\",\"language\":\"en\"}\nIdeal output:\n{\"decision\":\"Unresolved\",\"target\":null}\nExplanation (guidance only; not part of the output):\nA semantically useful free phrase is not thereby a Phraseme Lemma.\n\nExample 12\nInput:\n{\"canonicalForm\":\"-heit\",\"intendedUse\":\"Proposed both as the bound ending in Freiheit and as a standalone adjective; no source resolves the conflict.\",\"language\":\"de\"}\nIdeal output:\n{\"decision\":\"Unresolved\",\"target\":null}\nExplanation (guidance only; not part of the output):\nConflicting evidence must not be converted into an exact Family and Kind.","validationRoots":{"input":"laboratory.unitShadowClassification#input","modelInput":"laboratory.unitShadowClassification#model-input","output":"laboratory.unitShadowClassification#output"}}{"dispatch":{"modelOutputSchemaFor":"knowledge.de.combined:model-output-schema","outputPostcondition":"knowledge.de.combined:output-postcondition","projectOutput":"knowledge.de.combined:project-output"},"generationParams":{"model":"gpt-5.6-luna","maxOutputTokens":4096},"jsonSchemaPayloads":{"input":"{\"$schema\":\"http://json-schema.org/draft-07/schema#\",\"readOnly\":true,\"type\":\"object\",\"properties\":{\"markedContext\":{\"type\":\"string\",\"minLength\":1},\"reading\":{\"readOnly\":true,\"type\":\"object\",\"properties\":{\"lemma\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"ADJ\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"abbr\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"foreign\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"numType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Card\",\"Ord\"]},{\"type\":\"null\"}]},\"variant\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Short\"},{\"type\":\"null\"}]}},\"required\":[\"abbr\",\"foreign\",\"numType\",\"variant\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"ADP\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"abbr\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"adpType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Circ\",\"Post\",\"Prep\"]},{\"type\":\"null\"}]},\"extPos\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"ADV\",\"SCONJ\"]},{\"type\":\"null\"}]},\"foreign\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"governedCase\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Acc\",\"Abe\",\"Ben\",\"Cau\",\"Cmp\",\"Cns\",\"Com\",\"Dat\",\"Dis\",\"Equ\",\"Gen\",\"Ins\",\"Par\",\"Tem\",\"Abl\",\"Add\",\"Ade\",\"All\",\"Del\",\"Ela\",\"Ess\",\"Ill\",\"Ine\",\"Lat\",\"Loc\",\"Nom\",\"Per\",\"Sbe\",\"Sbl\",\"Spl\",\"Sub\",\"Sup\",\"Ter\"]},{\"type\":\"null\"}]},\"partType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Vbp\"]},{\"type\":\"null\"}]}},\"required\":[\"abbr\",\"adpType\",\"extPos\",\"foreign\",\"governedCase\",\"p