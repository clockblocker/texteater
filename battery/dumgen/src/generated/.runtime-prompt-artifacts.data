"string\",\"enum\":[\"Inf\"]},{\"type\":\"null\"}]},\"polarity\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Neg\",\"Pos\"]},{\"type\":\"null\"}]}},\"required\":[\"abbr\",\"foreign\",\"partType\",\"polarity\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"PRON\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"extPos\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"DET\"]},{\"type\":\"null\"}]},\"foreign\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"person\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"1\",\"2\",\"3\"]},{\"type\":\"null\"}]},\"polite\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Form\",\"Infm\"]},{\"type\":\"null\"}]},\"poss\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"pronType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Dem\",\"Ind\",\"Int\",\"Neg\",\"Prs\",\"Rcp\",\"Rel\",\"Tot\"]},{\"type\":\"null\"}]}},\"required\":[\"extPos\",\"foreign\",\"person\",\"polite\",\"poss\",\"pronType\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"PROPN\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"abbr\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"foreign\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"gender\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Fem\",\"Masc\",\"Neut\"]},{\"type\":\"null\"}]}},\"required\":[\"abbr\",\"foreign\",\"gender\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"PUNCT\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"punctType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Brck\",\"Colo\",\"Comm\",\"Dash\",\"Elip\",\"Excl\",\"Peri\",\"Qest\",\"Quot\"]},{\"type\":\"null\"}]}},\"required\":[\"punctType\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"SCONJ\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"conjType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Comp\"]},{\"type\":\"null\"}]}},\"required\":[\"conjType\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"SYM\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"foreign\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"numType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Card\",\"Range\"]},{\"type\":\"null\"}]}},\"required\":[\"foreign\",\"numType\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"VERB\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"hasGovPrep\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":1},{\"type\":\"null\"}]},\"hasSepPrefix\":{\"anyOf\":[{\"type\":\"string\",\"minLength\":1},{\"type\":\"null\"}]},\"lexicallyReflexive\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"verbType\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Mod\"},{\"type\":\"null\"}]}},\"required\":[\"hasGovPrep\",\"hasSepPrefix\",\"lexicallyReflexive\",\"verbType\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"canonicalForm\":{\"type\":\"string\",\"minLength\":1},\"family\":{\"type\":\"string\",\"const\":\"Lexeme\"},\"kind\":{\"type\":\"string\",\"const\":\"X\"},\"coreFeatures\":{\"type\":\"object\",\"properties\":{\"abbr\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"foreign\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"hyph\":{\"anyOf\":[{\"type\":\"string\",\"const\":\"Yes\"},{\"type\":\"null\"}]},\"numType\":{\"anyOf\":[{\"type\":\"string\",\"enum\":[\"Card\",\"Mult\",\"Range\"]},{\"type\":\"null\"}]}},\"required\":[\"abbr\",\"foreign\",\"hyph\",\"numType\"],\"additionalProperties\":false}},\"required\":[\"language\",\"canonicalForm\",\"family\",\"kind\",\"coreFeatures\"],\"additionalProperties\":false},{\"type\":\"object\",\"properties\":{\"language\":{\"type\":\"string\",\"const\":\"de\"},\"cano