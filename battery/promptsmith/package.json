{
	"name": "promptsmith",
	"version": "0.1.0",
	"description": "Schema-bound prompt authoring and reproducible evaluation.",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"convex": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./evaluation": {
			"bun": "./src/evaluation.ts",
			"convex": "./src/evaluation.ts",
			"types": "./dist/evaluation.d.ts",
			"import": "./dist/evaluation.js"
		},
		"./storage": {
			"bun": "./src/storage.ts",
			"convex": "./src/storage.ts",
			"types": "./dist/storage.d.ts",
			"import": "./dist/storage.js"
		},
		"./schemas": {
			"bun": "./src/schemas.ts",
			"convex": "./src/schemas.ts",
			"types": "./dist/schemas.d.ts",
			"import": "./dist/schemas.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "turbo run build:package",
		"build:package": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/evaluation.ts src/storage.ts src/schemas.ts --bundle --splitting --outdir=dist --platform=node --format=esm --packages=external",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../tooling/check-package-types.ts",
		"fix": "bun run --silent biome check --write .",
		"knip": "bun ../../tooling/knip.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run build",
		"test": "bun ../../tooling/run-package-tests.ts",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"common-utils": "workspace:^",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.13.3",
		"bun-types": "1.4.2",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"typescript": "^7.0.2"
	},
	"private": true
}
