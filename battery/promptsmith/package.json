{
	"name": "promptsmith",
	"version": "0.1.0",
	"description": "Schema-bound prompt authoring and reproducible evaluation.",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./codegen": {
			"types": "./dist/codegen.d.ts",
			"import": "./dist/codegen.js"
		},
		"./evaluation": {
			"types": "./dist/evaluation.d.ts",
			"import": "./dist/evaluation.js"
		},
		"./storage": {
			"types": "./dist/storage.d.ts",
			"import": "./dist/storage.js"
		},
		"./schemas": {
			"types": "./dist/schemas.d.ts",
			"import": "./dist/schemas.js"
		},
		"./package.json": "./package.json",
		"./openai": {
			"types": "./dist/openai.d.ts",
			"import": "./dist/openai.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/codegen.ts src/evaluation.ts src/storage.ts src/openai.ts src/schemas.ts --bundle --splitting --outdir=dist --platform=node --format=esm --packages=external",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run build",
		"test": "bun run build && bun test",
		"validate": "bun ../../tooling/validate-package.ts",
		"validate:test": "bun run test"
	},
	"dependencies": {
		"zod": "^4.4.0",
		"codegen": "workspace:^"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.13.3",
		"bun-types": "1.4.2",
		"codegen": "workspace:^",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"prinfer": "^2.3.0",
		"typescript": "^7.0.2"
	},
	"private": true
}
