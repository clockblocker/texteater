{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://unpkg.com/dumspec/schema/text-record.json",
	"title": "Dumspec Text Record",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"sourceText": {
			"type": "string",
			"minLength": 1
		},
		"status": {
			"type": "string",
			"enum": [
				"Draft",
				"Reviewed"
			]
		},
		"legacy": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"source": {
						"type": "string",
						"minLength": 1
					},
					"caseId": {
						"type": "string",
						"minLength": 1
					},
					"memberSegmentIndices": {
						"minItems": 1,
						"type": "array",
						"items": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						}
					},
					"case": {}
				},
				"required": [
					"source",
					"caseId",
					"case"
				],
				"additionalProperties": false
			}
		}
	},
	"required": [
		"sourceText",
		"status"
	],
	"additionalProperties": false
}
