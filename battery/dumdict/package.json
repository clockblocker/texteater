{
	"name": "dumdict",
	"version": "0.1.0",
	"description": "Dictionary workflows and storage helpers built on dumling and dumrel.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"license": "MIT",
	"sideEffects": [
		"./dist/chunk-*.js"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"bun": "./src/index.ts",
			"convex": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./schema": {
			"bun": "./src/public-schema.ts",
			"convex": "./src/public-schema.ts",
			"types": "./dist/public-schema.d.ts",
			"import": "./dist/public-schema.js"
		},
		"./runtime": {
			"bun": "./src/runtime.ts",
			"convex": "./src/runtime.ts",
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js"
		},
		"./pending": {
			"bun": "./src/pending.ts",
			"convex": "./src/pending.ts",
			"types": "./dist/pending.d.ts",
			"import": "./dist/pending.js"
		},
		"./planning": {
			"bun": "./src/planning.ts",
			"convex": "./src/planning.ts",
			"types": "./dist/planning.d.ts",
			"import": "./dist/planning.js"
		},
		"./package.json": "./package.json",
		"./memory": {
			"bun": "./src/memory.ts",
			"convex": "./src/memory.ts",
			"types": "./dist/memory.d.ts",
			"import": "./dist/memory.js"
		},
		"./testing": {
			"bun": "./src/testing/index.ts",
			"convex": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "turbo run build:package",
		"build:package": "bun ../../tooling/manifest-policy.ts package && bun run generate:validation:check && bun run build:js && bun run build:types && bun run build:contract",
		"build:contract": "bun run tests/published-build-contract.ts",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/schema.ts src/public-schema.ts src/runtime.ts src/memory.ts src/pending.ts src/planning.ts --bundle --external:dumval --external:common-utils --external:dumling --external:dumrel --splitting --outdir=dist --platform=node --format=esm --packages=external --tsconfig=tsconfig.build.json",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"generate:validation": "bun codegen/generate-validation-artifacts.ts",
		"generate:validation:check": "bun codegen/generate-validation-artifacts.ts --check",
		"generate:readme": "bun run generate-readme/generate-readme.ts",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run generate:readme && bun run build",
		"test": "bun test",
		"test:internal": "bun test tests/internal",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"common-utils": "workspace:^",
		"dumrel": "workspace:^",
		"dumspec": "workspace:^",
		"zod": "^4.4.0",
		"effect": "4.0.0",
		"dumling": "workspace:^",
		"dumval": "workspace:^"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@types/node": "^24.13.3",
		"bun-types": "1.4.2",
		"codegen": "workspace:^",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"prinfer": "^2.3.0",
		"typescript": "^7.0.2"
	}
}
