{
	"extends": "../../tooling/typescript/battery.json",
	"compilerOptions": {
		"paths": {
			"dumdict": ["./src/index.ts"],
			"dumdict/pending": ["./src/pending.ts"],
			"dumdict/runtime": ["./src/runtime.ts"],
			"dumling": ["../dumling-new/src/index.ts"],
			"dumling/types": ["../dumling-new/src/types.ts"],
			"dumling/validation": [
				"../dumling-new/src/validation/operations.ts"
			],
			"dumling/schema/*": ["../dumling-new/src/generated/schemas/*"],
			"dumrel": ["../dumrel-new/src/index.ts"],
			"dumrel/types": ["../dumrel-new/src/types.ts"],
			"dumrel/schema": ["../dumrel-new/src/schemas.ts"]
		}
	},
	"include": ["generate-readme/**/*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
