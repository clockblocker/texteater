{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"paths": {
			"dumdict": ["./src/index.ts"],
			"dumdict/pending": ["./src/pending.ts"],
			"dumdict/runtime": ["./src/runtime.ts"],
			"dumling": ["../dumling/src/index.ts"],
			"dumling/types": ["../dumling/src/types.ts"],
			"dumling/validation": ["../dumling/src/validation/operations.ts"],
			"dumling/validation-artifact": [
				"../dumling/src/generated/validation.ts"
			],
			"dumling/schema/*": ["../dumling/src/generated/schemas/*"],
			"dumrel": ["../dumrel/src/index.ts"],
			"dumrel/schema": ["../dumrel/src/schemas.ts"],
			"dumrel/types": ["../dumrel/src/types.ts"],
			"dumrel/validation-artifact": ["../dumrel/src/generated/validation.ts"]
		}
	}
}
