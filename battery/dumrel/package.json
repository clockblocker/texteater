{
	"name": "dumrel",
	"version": "0.1.0",
	"description": "Typed Reading Knowledge, validation, merge rules, and semantic relation algebra.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js",
			"default": "./dist/types.js"
		},
		"./relations": {
			"types": "./dist/relations.d.ts",
			"import": "./dist/relations.js",
			"default": "./dist/relations.js"
		},
		"./schema": {
			"types": "./dist/schema.d.ts",
			"import": "./dist/schema.js",
			"default": "./dist/schema.js"
		},
		"./settings": {
			"types": "./dist/settings.d.ts",
			"import": "./dist/settings.js",
			"default": "./dist/settings.js"
		},
		"./fixed": {
			"types": "./dist/fixed.d.ts",
			"import": "./dist/fixed.js",
			"default": "./dist/fixed.js"
		},
		"./vocabulary": {
			"types": "./dist/vocabulary.d.ts",
			"import": "./dist/vocabulary.js",
			"default": "./dist/vocabulary.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/types.ts src/relations.ts src/schema.ts src/settings.ts src/fixed.ts src/vocabulary.ts --bundle --outdir=dist --platform=node --format=esm --packages=external --tsconfig=tsconfig.build.json",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"check:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.type-tests.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"generate:validation": "bun run codegen/generate-validation-artifacts.ts",
		"generate:validation:check": "bun run codegen/generate-validation-artifacts.ts --check",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run build",
		"test": "bun test",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"common-utils": "workspace:^",
		"dumling": "workspace:^",
		"emoji-regex": "^10.6.0",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.13.3",
		"bun-types": "1.3.14",
		"codegen": "workspace:^",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"typescript": "^7.0.2"
	}
}
