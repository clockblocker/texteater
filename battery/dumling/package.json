{
	"name": "dumling",
	"version": "0.1.12",
	"description": "TypeScript and Zod schemas, DTO types, operations, and stable IDs for learner-facing linguistic annotation.",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"typescript",
		"zod",
		"schema",
		"linguistics",
		"nlp",
		"annotation",
		"lemma",
		"inflection",
		"segmentation",
		"language-learning",
		"english",
		"german",
		"hebrew"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js",
			"default": "./dist/types.js"
		},
		"./schema": {
			"types": "./dist/public-schema.d.ts",
			"import": "./dist/public-schema.js",
			"default": "./dist/public-schema.js"
		},
		"./dangerously-heavy-schema-tree": {
			"types": "./dist/dangerously-heavy-schema-tree.d.ts",
			"import": "./dist/dangerously-heavy-schema-tree.js",
			"default": "./dist/dangerously-heavy-schema-tree.js"
		},
		"./reading": {
			"types": "./dist/reading.d.ts",
			"import": "./dist/reading.js",
			"default": "./dist/reading.js"
		},
		"./fixed": {
			"types": "./dist/fixed.d.ts",
			"import": "./dist/fixed.js",
			"default": "./dist/fixed.js"
		},
		"./id": {
			"types": "./dist/id.d.ts",
			"import": "./dist/id.js",
			"default": "./dist/id.js"
		},
		"./vocabulary": {
			"types": "./dist/vocabulary.d.ts",
			"import": "./dist/vocabulary.js",
			"default": "./dist/vocabulary.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": "24.x"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && ../../node_modules/.bin/esbuild src/index.ts src/types.ts src/schema.ts src/public-schema.ts src/dangerously-heavy-schema-tree.ts src/id.ts src/reading.ts src/fixed.ts src/vocabulary.ts --bundle --outdir=dist --platform=node --format=esm --packages=external",
		"build:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"check:types": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.type-tests.json --noEmit",
		"fix": "bun run --silent biome check --write .",
		"generate": "bun run generate:validation && bun run generate:readme",
		"generate:validation": "bun run codegen/generate-validation-artifacts.ts",
		"generate:validation:check": "bun run codegen/generate-validation-artifacts.ts --check",
		"generate:readme": "bun run generate-readme/generate-readme.ts",
		"knip": "bun ../../node_modules/knip/bin/knip.js --config ../../tooling/knip-package.ts",
		"lint": "bun run --silent biome check .",
		"prepack": "bun run generate:readme && bun run build",
		"test": "bun test",
		"test:package": "bun test ./tests/internal/package-hygine/package-entrypoints.check.ts",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"common-utils": "workspace:^",
		"codec-builder-library": "workspace:^",
		"emoji-regex": "^10.6.0",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.13.3",
		"bun-types": "1.3.14",
		"codegen": "workspace:^",
		"dependency-cruiser": "^18.1.0",
		"esbuild": "^0.28.1",
		"knip": "^6.29.0",
		"typescript": "^7.0.2"
	}
}
