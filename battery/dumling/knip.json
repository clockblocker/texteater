{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/types.ts",
		"src/validation/operations.ts",
		"src/generated/linked-validation.ts",
		"src/generated/validation.ts",
		"src/generated/schemas/**/*.ts",
		"src/schemas/concrete-language/*/*/*.ts",
		"codegen/operations.ts",
		"codegen/output-types.ts",
		"codegen/routes.ts",
		"generate-readme/examples/**/*.ts",
		"tests/**/*.ts"
	],
	"project": [
		"codegen/**/*.ts",
		"generate-readme/**/*.ts",
		"src/**/*.ts",
		"tests/**/*.ts"
	],
	"ignoreDependencies": ["bun-types", "dependency-cruiser"]
}
