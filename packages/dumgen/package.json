{
	"name": "dumgen",
	"version": "0.1.0",
	"description": "Generation helpers built on top of dumling.",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.0",
	"license": "MIT",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": ["dist", "README.md", "LICENSE"],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "bun run build:js && bun run build:types",
		"build:js": "rm -rf dist && bun build src/index.ts --outfile dist/index.js --format esm --target node --packages external",
		"build:types": "bunx tsc -p tsconfig.build.json",
		"check": "tsgo -p tsconfig.json --noEmit",
		"fix": "bunx @biomejs/biome check --write .",
		"generate:readme": "bun run generate-readme/generate-readme.ts",
		"knip": "bunx knip",
		"lint": "bunx @biomejs/biome check .",
		"prepack": "bun run generate:readme && bun run build",
		"test": "bun test",
		"test:external": "bun test tests/external",
		"test:internal": "bun test tests/internal"
	},
	"dependencies": {
		"dumdict": "workspace:^",
		"dumling": "workspace:^",
		"neverthrow": "^8.2.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^24.5.2",
		"@typescript/native-preview": "beta",
		"bun-types": "1.3.0",
		"knip": "^5.82.1",
		"typescript": "^5.9.3"
	}
}
