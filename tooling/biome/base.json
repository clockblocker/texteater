{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"files": {
		"includes": [
			"**",
			"!!dist",
			"!!node_modules",
			"!!.astro",
			"!!bun.lock",
			"!!**/bun.lock",
			"!!package-lock.json",
			"!!**/package-lock.json",
			"!!pnpm-lock.yaml",
			"!!**/pnpm-lock.yaml",
			"!!yarn.lock",
			"!!**/yarn.lock"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "lf",
		"lineWidth": 80
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"correctness": {
				"noUnusedImports": "error"
			}
		}
	}
}
