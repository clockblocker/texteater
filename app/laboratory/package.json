{
	"name": "@texteater/laboratory",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && vite build && bun build src/server.ts --outdir dist/server --target bun",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"dev": "bun scripts/dev.ts",
		"fix": "bun run --silent biome check --write .",
		"lint": "bun run --silent biome check .",
		"test": "bun test",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"dumgen": "workspace:^",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	},
	"devDependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"vite": "^7.3.1"
	}
}
