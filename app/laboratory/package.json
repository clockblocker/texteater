{
	"name": "@texteater/laboratory",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && vite build && bun build src/server.ts --outdir dist/server --target bun",
		"check": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
		"dev": "bun scripts/dev.ts",
		"fix": "bun run --silent biome check --write .",
		"lint": "bun run --silent biome check .",
		"test": "bun test",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fontsource-variable/inter": "^5.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dumdict": "workspace:^",
		"dumgen": "workspace:^",
		"dumling": "workspace:^",
		"lucide-react": "^1.28.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-resizable-panels": "^4.12.2",
		"shadcn": "^4.16.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.3.3",
		"vite": "^7.3.1"
	}
}
