{
	"name": "@texteater/tf-demo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "bun ../../tooling/manifest-policy.ts package && bun run check && vite build",
		"check": "bun run check:relation-policy && bun ../../node_modules/typescript/bin/tsc -b && bun ../../node_modules/typescript/bin/tsc -p tsconfig.type-tests.json --noEmit",
		"check:relation-policy": "bun tooling/compile-relation-verdict.ts --check",
		"compile:relation-policy": "bun tooling/compile-relation-verdict.ts",
		"dev": "ISOLATE_MAX_USER_HEAP_SIZE=134217728 CONVEX_AGENT_MODE=anonymous convex dev --start 'vite' || { status=$?; bun tooling/report-convex-port-owner.ts 3210; exit $status; }",
		"fix": "bun run --silent biome check --write .",
		"lint": "bun run --silent biome check .",
		"preview": "vite preview",
		"reset": "CONVEX_AGENT_MODE=anonymous convex run demoReset:resetDemoData",
		"test": "bun ../../tooling/run-package-tests.ts",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@convex-dev/react-query": "^0.1.0",
		"@dnd-kit/core": "6.3.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@react-spring/web": "10.1.2",
		"@tailwindcss/vite": "^4",
		"@tanstack/react-query": "^5.101.4",
		"@use-gesture/react": "10.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"convex": "^1.44.0",
		"dumdict": "workspace:^",
		"dumgen": "workspace:^",
		"dumling": "workspace:^",
		"dumrel": "workspace:^",
		"lucide-react": "^1.31.0",
		"motion": "13.1.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-router-dom": "^7.18.2",
		"shadcn": "^4.18.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"vite": "^8"
	}
}
