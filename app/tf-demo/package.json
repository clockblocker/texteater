{
	"name": "@texteater/tf-demo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "turbo run build:package",
		"build:package": "bun ../../tooling/manifest-policy.ts package && bun run check && vite build",
		"check": "bun run check:relation-policy && bun ../../node_modules/typescript/bin/tsc -b && bun ../../node_modules/typescript/bin/tsc -p tsconfig.type-tests.json --noEmit",
		"check:relation-policy": "bun tooling/compile-relation-verdict.ts --check",
		"compile:relation-policy": "bun tooling/compile-relation-verdict.ts",
		"env:sync": "sh tooling/sync-convex-env.sh",
		"dev": "turbo run dev:package",
		"dev:package": "sh tooling/sync-convex-env.sh; ISOLATE_MAX_USER_HEAP_SIZE=134217728 CONVEX_AGENT_MODE=anonymous convex dev --start 'vite' || { status=$?; bun tooling/report-convex-port-owner.ts 3210; exit $status; }",
		"dev:mouse": "VITE_TF_MOUSE_TRACE=1 bun run dev",
		"fix": "bun run --silent biome check --write .",
		"lint": "bun run --silent biome check .",
		"preview": "vite preview",
		"reset": "CONVEX_AGENT_MODE=anonymous convex run demoReset:resetDemoData",
		"test": "bun ../../tooling/run-package-tests.ts",
		"test:e2e": "playwright test",
		"test:pipeline:live": "bun tooling/run-live-pipeline.ts",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"@convex-dev/migrations": "^0.3.6",
		"@convex-dev/react-query": "^0.1.0",
		"@tailwindcss/vite": "^4",
		"@tanstack/react-query": "^5.101.4",
		"common-utils": "workspace:^",
		"convex": "^1.44.0",
		"dumdict": "workspace:^",
		"dumgen": "workspace:^",
		"dumling": "workspace:^",
		"dumrel": "workspace:^",
		"effect": "3.22.1",
		"lego": "workspace:^",
		"lucide-react": "^1.31.0",
		"motion": "^13.1.1",
		"promptsmith": "workspace:^",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-resizable-panels": "workspace:^",
		"zod": "^4.4.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6",
		"convex-test": "^0.0.59",
		"vite": "^8"
	}
}
