{
	"name": "@dumling/docs-site",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.0",
	"scripts": {
		"astro:build": "astro build",
		"build": "bun ../../tooling/manifest-policy.ts package && bun run astro:build && bun run scripts/flatten-html-routes.ts",
		"check": "tsgo -p tsconfig.json --noEmit",
		"dev": "bun run generate:content && astro dev",
		"generate:attestations": "bun run scripts/generate-attestations.ts",
		"generate:content": "bun run scripts/generate-content.ts",
		"generate:docs": "bun run scripts/generate-docs.ts",
		"generate": "bun run generate:attestations && bun run generate:content bun run generate:docs",
		"prebuild": "bun ../../tooling/manifest-policy.ts package && bun run generate:content",
		"preview": "astro preview",
		"test": "bun test",
		"validate": "bun ../../tooling/validate-package.ts"
	},
	"dependencies": {
		"astro": "^6.1.8",
		"dumling": "workspace:^"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@typescript/native-preview": "beta",
		"@types/node": "^24.5.2",
		"dependency-cruiser": "^17.3.3",
		"knip": "^5.82.1",
		"typescript": "^5.9.3"
	}
}
