{
	"extends": ["../../tooling/biome/base.json"],
	"files": {
		"includes": [
			"!!dist",
			"!!node_modules",
			"!!.astro",
			"!!.dumcodegen",
			"!!public/**/*.md",
			"!!public/nav.json",
			"!!src/generated"
		]
	},
	"overrides": [
		{
			"includes": ["**/*.astro"],
			"linter": {
