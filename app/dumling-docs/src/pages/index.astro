---
import { getCollection, getEntry, render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import { hrefForPage, navItems, routeIdForPage } from "../lib/navigation";

const page = await getEntry("docs", "index");
if (page === undefined) {
	throw new Error("Missing docs index page.");
}

const docs = await getCollection("docs");
const items = navItems(
	docs.map((doc) => ({ ...doc.data, routeId: routeIdForPage(doc) })),
);
const { Content } = await render(page);
const currentHref = hrefForPage(page);
---

<DocsLayout
	currentHref={currentHref}
	description={page.data.description}
	navItems={items}
	title={page.data.title}
>
	<Content />
</DocsLayout>
